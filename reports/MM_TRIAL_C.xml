<?xml version="1.0" encoding="UTF-8" ?>
<report name="mm_trial_c" DTDVersion="9.0.2.0.10" unitOfMeasurement="inch">
  <data>
    <userParameter name="P_FROM" datatype="character" width="10"/>
    <userParameter name="P_TO" datatype="character" width="10"/>
    <dataSource name="Q_ROWS">
      <select>
      <![CDATA[select mm_report.label('CUSTOMERS') grp, t.code afm, t.name partner, t.open_bal, t.debit, t.credit, t.close_bal
from table(mm_ledger.trial_rows('C', to_date(:P_FROM, 'DD/MM/YYYY'), to_date(:P_TO, 'DD/MM/YYYY'))) t]]>
      </select>
      <group name="G_BRK">
        <dataItem name="GRP" datatype="vchar2" columnOrder="11" width="40" defaultLabel="Grp">
          <dataDescriptor expression="grp" descriptiveExpression="GRP" order="1" width="40"/>
        </dataItem>
      </group>
      <group name="G_ROWS">
        <dataItem name="AFM" datatype="vchar2" columnOrder="12" width="40" defaultLabel="Afm">
          <dataDescriptor expression="afm" descriptiveExpression="AFM" order="2" width="40"/>
        </dataItem>
        <dataItem name="PARTNER" datatype="vchar2" columnOrder="13" width="200" defaultLabel="Partner">
          <dataDescriptor expression="partner" descriptiveExpression="PARTNER" order="3" width="200"/>
        </dataItem>
        <dataItem name="OPEN_BAL" datatype="number" columnOrder="14" width="22" defaultLabel="Open_Bal">
          <dataDescriptor expression="open_bal" descriptiveExpression="OPEN_BAL" order="4" width="22"/>
        </dataItem>
        <dataItem name="DEBIT" datatype="number" columnOrder="15" width="22" defaultLabel="Debit">
          <dataDescriptor expression="debit" descriptiveExpression="DEBIT" order="5" width="22"/>
        </dataItem>
        <dataItem name="CREDIT" datatype="number" columnOrder="16" width="22" defaultLabel="Credit">
          <dataDescriptor expression="credit" descriptiveExpression="CREDIT" order="6" width="22"/>
        </dataItem>
        <dataItem name="CLOSE_BAL" datatype="number" columnOrder="17" width="22" defaultLabel="Close_Bal">
          <dataDescriptor expression="close_bal" descriptiveExpression="CLOSE_BAL" order="7" width="22"/>
        </dataItem>
      </group>
    </dataSource>
    <summary name="CS_G_OPEN_BAL" source="OPEN_BAL" function="sum" width="22" precision="14" scale="2" reset="report" compute="report"/>
    <summary name="CS_G_DEBIT" source="DEBIT" function="sum" width="22" precision="14" scale="2" reset="report" compute="report"/>
    <summary name="CS_G_CREDIT" source="CREDIT" function="sum" width="22" precision="14" scale="2" reset="report" compute="report"/>
    <summary name="CS_G_CLOSE_BAL" source="CLOSE_BAL" function="sum" width="22" precision="14" scale="2" reset="report" compute="report"/>
    <formula name="CF_TITLE" source="cf_titleformula" datatype="character" width="200"/>
    <formula name="CF_PERIOD" source="cf_periodformula" datatype="character" width="200"/>
    <formula name="CF_PAGE" source="cf_pageformula" datatype="character" width="200"/>
