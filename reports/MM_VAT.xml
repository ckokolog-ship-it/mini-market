<?xml version="1.0" encoding="UTF-8" ?>
<report name="mm_vat" DTDVersion="9.0.2.0.10" unitOfMeasurement="inch">
  <data>
    <userParameter name="P_FROM" datatype="character" width="10"/>
    <userParameter name="P_TO" datatype="character" width="10"/>
    <dataSource name="Q_ROWS">
      <select>
      <![CDATA[select to_char(day, 'YYYY-MM') month_key, to_char(day, 'MM/YYYY') month_text, vat_code || ' ' || vat_rate || '%' vat_text, sum(s_net) s_net, sum(s_vat) s_vat, sum(p_net) p_net, sum(p_vat) p_vat, sum(s_vat) - sum(p_vat) payable
from mm_vat_day
where day between to_date(:P_FROM, 'DD/MM/YYYY') and to_date(:P_TO, 'DD/MM/YYYY')
group by to_char(day, 'YYYY-MM'), to_char(day, 'MM/YYYY'), vat_code, vat_rate
order by 1, 3]]>
      </select>
      <group name="G_BRK">
        <dataItem name="MONTH_KEY" datatype="vchar2" columnOrder="11" width="7" defaultLabel="Month_Key">
          <dataDescriptor expression="month_key" descriptiveExpression="MONTH_KEY" order="1" width="7"/>
        </dataItem>
        <dataItem name="MONTH_TEXT" datatype="vchar2" columnOrder="12" width="7" defaultLabel="Month_Text">
          <dataDescriptor expression="month_text" descriptiveExpression="MONTH_TEXT" order="2" width="7"/>
        </dataItem>
        <summary name="CS_S_S_NET" source="S_NET" function="sum" width="22" precision="14" scale="2" reset="G_BRK" compute="report"/>
        <summary name="CS_S_S_VAT" source="S_VAT" function="sum" width="22" precision="14" scale="2" reset="G_BRK" compute="report"/>
        <summary name="CS_S_P_NET" source="P_NET" function="sum" width="22" precision="14" scale="2" reset="G_BRK" compute="report"/>
        <summary name="CS_S_P_VAT" source="P_VAT" function="sum" width="22" precision="14" scale="2" reset="G_BRK" compute="report"/>
        <summary name="CS_S_PAYABLE" source="PAYABLE" function="sum" width="22" precision="14" scale="2" reset="G_BRK" compute="report"/>
      </group>
      <group name="G_ROWS">
        <dataItem name="VAT_TEXT" datatype="vchar2" columnOrder="13" width="10" defaultLabel="Vat_Text">
          <dataDescriptor expression="vat_text" descriptiveExpression="VAT_TEXT" order="3" width="10"/>
        </dataItem>
        <dataItem name="S_NET" datatype="number" columnOrder="14" width="22" defaultLabel="S_Net">
          <dataDescriptor expression="s_net" descriptiveExpression="S_NET" order="4" width="22"/>
        </dataItem>
        <dataItem name="S_VAT" datatype="number" columnOrder="15" width="22" defaultLabel="S_Vat">
