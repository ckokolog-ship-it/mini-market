        </dataItem>
        <summary name="CS_S_ALP_DOCS" source="ALP_DOCS" function="sum" width="22" precision="14" scale="2" reset="G_BRK" compute="report"/>
        <summary name="CS_S_ALP_TOTAL" source="ALP_TOTAL" function="sum" width="22" precision="14" scale="2" reset="G_BRK" compute="report"/>
