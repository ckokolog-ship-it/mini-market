      <![CDATA[select to_char(day, 'YYYY-MM') month_key, to_char(day, 'MM/YYYY') month_text, day, alp_docs, alp_total, tpy_total, ppy_total, total
from mm_sales_day
where day between to_date(:P_FROM, 'DD/MM/YYYY') and to_date(:P_TO, 'DD/MM/YYYY')
order by day]]>
      </select>
