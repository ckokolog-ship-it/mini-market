              </field>
              <field name="F_END_Q" source="END_Q" minWidowLines="1" spacing="0" alignment="end">
                <font face="Arial" size="8"/>
                <geometryInfo x="6.45000" y="0.22100" width="0.85000" height="0.17000"/>
              </field>
          </repeatingFrame>
          <frame name="M_SUB">
            <geometryInfo x="0.00000" y="0.44200" width="7.30000" height="0.27200"/>
            <field name="F_S_L" source="CF_SUBTOTAL_CAT" minWidowLines="1" spacing="0" alignment="start">
              <font face="Arial" size="8" bold="yes"/>
              <geometryInfo x="1.05000" y="0.47600" width="2.20000" height="0.17000"/>
            </field>
            <field name="F_S_CODE" source="CS_S_CODE" minWidowLines="1" spacing="0" alignment="end" formatMask="NNNGNNNGNN0">
              <font face="Arial" size="8" bold="yes"/>
              <geometryInfo x="0.00000" y="0.47600" width="1.00000" height="0.17000"/>
            </field>
          </frame>
        </repeatingFrame>
