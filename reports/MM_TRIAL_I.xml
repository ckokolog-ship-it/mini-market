<?xml version="1.0" encoding="UTF-8" ?>
<report name="mm_trial_i" DTDVersion="9.0.2.0.10" unitOfMeasurement="inch">
  <data>
    <userParameter name="P_FROM" datatype="character" width="10"/>
    <userParameter name="P_TO" datatype="character" width="10"/>
    <dataSource name="Q_ROWS">
      <select>
      <![CDATA[select c.name category, t.code, t.name, t.unit, mm_report.qty(t.open_bal) open_q, mm_report.qty(t.debit) in_q, mm_report.qty(t.credit) out_q, mm_report.qty(t.close_bal) end_q
from table(mm_ledger.trial_rows('I', to_date(:P_FROM, 'DD/MM/YYYY'), to_date(:P_TO, 'DD/MM/YYYY'))) t
join mm_item i on i.id = t.id join mm_category c on c.id = i.category_id
order by c.name, t.code]]>
      </select>
      <group name="G_BRK">
        <dataItem name="CATEGORY" datatype="vchar2" columnOrder="11" width="60" defaultLabel="Category">
          <dataDescriptor expression="category" descriptiveExpression="CATEGORY" order="1" width="60"/>
        </dataItem>
        <summary name="CS_S_CODE" source="CODE" function="count" width="22" precision="14" scale="2" reset="G_BRK" compute="report"/>
      </group>
      <group name="G_ROWS">
        <dataItem name="CODE" datatype="vchar2" columnOrder="12" width="40" defaultLabel="Code">
          <dataDescriptor expression="code" descriptiveExpression="CODE" order="2" width="40"/>
        </dataItem>
        <dataItem name="NAME" datatype="vchar2" columnOrder="13" width="200" defaultLabel="Name">
          <dataDescriptor expression="name" descriptiveExpression="NAME" order="3" width="200"/>
        </dataItem>
        <dataItem name="UNIT" datatype="vchar2" columnOrder="14" width="10" defaultLabel="Unit">
          <dataDescriptor expression="unit" descriptiveExpression="UNIT" order="4" width="10"/>
        </dataItem>
        <dataItem name="OPEN_Q" datatype="vchar2" columnOrder="15" width="30" defaultLabel="Open_Q">
          <dataDescriptor expression="open_q" descriptiveExpression="OPEN_Q" order="5" width="30"/>
        </dataItem>
        <dataItem name="IN_Q" datatype="vchar2" columnOrder="16" width="30" defaultLabel="In_Q">
          <dataDescriptor expression="in_q" descriptiveExpression="IN_Q" order="6" width="30"/>
        </dataItem>
        <dataItem name="OUT_Q" datatype="vchar2" columnOrder="17" width="30" defaultLabel="Out_Q">
          <dataDescriptor expression="out_q" descriptiveExpression="OUT_Q" order="7" width="30"/>
        </dataItem>
        <dataItem name="END_Q" datatype="vchar2" columnOrder="18" width="30" defaultLabel="End_Q">
          <dataDescriptor expression="end_q" descriptiveExpression="END_Q" order="8" width="30"/>
        </dataItem>
      </group>
    </dataSource>
    <summary name="CS_G_CODE" source="CODE" function="count" width="22" precision="14" scale="2" reset="report" compute="report"/>
    <formula name="CF_TITLE" source="cf_titleformula" datatype="character" width="200"/>
    <formula name="CF_PERIOD" source="cf_periodformula" datatype="character" width="200"/>
    <formula name="CF_PAGE" source="cf_pageformula" datatype="character" width="200"/>
    <formula name="CF_SUBTOTAL_CAT" source="cf_subtotal_catformula" datatype="character" width="200"/>
    <formula name="CF_GRAND_CAT" source="cf_grand_catformula" datatype="character" width="200"/>
    <formula name="CF_CODE" source="cf_codeformula" datatype="character" width="200"/>
    <formula name="CF_NAME" source="cf_nameformula" datatype="character" width="200"/>
    <formula name="CF_UNIT" source="cf_unitformula" datatype="character" width="200"/>
    <formula name="CF_OPEN_Q" source="cf_open_qformula" datatype="character" width="200"/>
    <formula name="CF_IN_Q" source="cf_in_qformula" datatype="character" width="200"/>
    <formula name="CF_OUT_Q" source="cf_out_qformula" datatype="character" width="200"/>
    <formula name="CF_END_Q" source="cf_end_qformula" datatype="character" width="200"/>
  </data>
  <layout>
