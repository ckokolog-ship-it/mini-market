            <font face="Arial" size="8" bold="yes"/>
            <geometryInfo x="1.05000" y="0.91800" width="2.20000" height="0.17000"/>
          </field>
          <field name="F_G_CODE" source="CS_G_CODE" minWidowLines="1" spacing="0" alignment="end" formatMask="NNNGNNNGNN0">
            <font face="Arial" size="8" bold="yes"/>
            <geometryInfo x="0.00000" y="0.91800" width="1.00000" height="0.17000"/>
          </field>
        </frame>
      </frame>
    </body>
    <margin>
